/* The tool side of the MSL ModelicaExternalC sources this FMU ships.

   MLS 12.9.6 makes the simulation environment provide the ModelicaUtilities.h
   functions an external C function may call. The shipped sources also
   reference ModelicaInternal_getTime and ModelicaInternal_getpid (for the
   automatic global seed), which the full ModelicaExternalC library defines in
   ModelicaInternal.c; this FMU provides them here instead of shipping that
   file. None of the external functions this FMU calls reaches these on a
   successful call. Generated by Rumoca. */
#if !defined(_POSIX_C_SOURCE)
#define _POSIX_C_SOURCE 200112L
#endif
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#if defined(_WIN32)
#include <process.h>
#define RMC_GETPID _getpid
#else
#include <unistd.h>
#define RMC_GETPID getpid
#endif
#include "ModelicaUtilities.h"
#include "ModelicaInternal.h"

#if defined(__GNUC__) && !defined(_WIN32)
#define RMC_HIDDEN __attribute__((visibility("hidden")))
#else
#define RMC_HIDDEN
#endif

RMC_HIDDEN void ModelicaVFormatMessage(const char* string, va_list args) {
    vfprintf(stderr, string, args);
}

RMC_HIDDEN void ModelicaMessage(const char* string) {
    fputs(string, stderr);
}

RMC_HIDDEN void ModelicaFormatMessage(const char* string, ...) {
    va_list args;
    va_start(args, string);
    ModelicaVFormatMessage(string, args);
    va_end(args);
}

RMC_HIDDEN void ModelicaVFormatWarning(const char* string, va_list args) {
    ModelicaVFormatMessage(string, args);
}

RMC_HIDDEN void ModelicaWarning(const char* string) {
    ModelicaMessage(string);
}

RMC_HIDDEN void ModelicaFormatWarning(const char* string, ...) {
    va_list args;
    va_start(args, string);
    ModelicaVFormatMessage(string, args);
    va_end(args);
}

/* An external function that signals an error cannot return a value to the
   FMU, so the process stops instead of continuing with an undefined result. */
RMC_HIDDEN MODELICA_NORETURN void ModelicaVFormatError(const char* string, va_list args) {
    ModelicaVFormatMessage(string, args);
    fputc('\n', stderr);
    abort();
}

RMC_HIDDEN MODELICA_NORETURN void ModelicaError(const char* string) {
    ModelicaMessage(string);
    fputc('\n', stderr);
    abort();
}

RMC_HIDDEN MODELICA_NORETURN void ModelicaFormatError(const char* string, ...) {
    va_list args;
    va_start(args, string);
    ModelicaVFormatError(string, args);
}

RMC_HIDDEN char* ModelicaAllocateStringWithErrorReturn(size_t len) {
    return (char*)calloc(len + 1, 1);
}

RMC_HIDDEN char* ModelicaAllocateString(size_t len) {
    char* string = ModelicaAllocateStringWithErrorReturn(len);
    if (string == NULL) {
        ModelicaError("Not enough memory to allocate a string");
    }
    return string;
}

RMC_HIDDEN void ModelicaInternal_getTime(int* ms, int* sec, int* min, int* hour, int* mday,
                                         int* mon, int* year) {
    time_t now = time(NULL);
    struct tm* local = localtime(&now);
    *ms = 0;
    *sec = local ? local->tm_sec : 0;
    *min = local ? local->tm_min : 0;
    *hour = local ? local->tm_hour : 0;
    *mday = local ? local->tm_mday : 1;
    *mon = local ? local->tm_mon + 1 : 1;
    *year = local ? local->tm_year + 1900 : 1970;
}

RMC_HIDDEN int ModelicaInternal_getpid(void) {
    return (int)RMC_GETPID();
}
