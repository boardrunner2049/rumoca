{#- Time events (time_events.rs TimeEventProfile): the instants the component
    announces as nextEventTime and at which Co-Simulation stops. The owners
    and their merge are the linked runtime's stop schedule (runtime/
    schedule.rs next_stop, solve_events.rs next_runtime_event_stop). -#}
{%- macro time_events(solve, te, prefix) %}
/* timeline.rs sample_time_match_with_tol. */
static bool rmc_time_match(double a, double b) {
    return fabs(a - b) <= {{ te.match_tolerance }} * (1.0 + fmax(fabs(a), fabs(b)));
}
static void rmc_set_initial_flag(ModelInstance* m, double value) {
{%- if te.initial_flag is not none %}
    m->p[{{ te.initial_flag }}] = value;
{%- else %}
    (void)m; (void)value;
{%- endif %}
}
static void rmc_clear_initial_flag(ModelInstance* m) { rmc_set_initial_flag(m, 0.0); }
/* component.rs public_time_eval_time: after a time event observed at its
   right limit, every read at the event instant takes that right limit, so a
   time relation reads its post-event side together with the post-event
   discrete values, until integration moves on (CompletedIntegratorStep, or
   a later time). The caller restores the returned time. */
static double rmc_public_time_enter(ModelInstance* m) {
    double saved = m->time;
    if (m->rmc_post_defined && rmc_time_match(m->time, m->rmc_post_anchor)) m->time = m->rmc_post_time;
    return saved;
}
/* component.rs continuous_eval_time: a derivative or indicator read at an
   announced time event, before Event Mode handles it, takes the instant's
   left limit; any other read takes the public evaluation time. */
static double rmc_continuous_time_enter(ModelInstance* m) {
    double saved = m->time, left = nextafter(m->rmc_next_time, -INFINITY);
    if (m->rmc_next_defined && m->rmc_next_right && m->time > left && rmc_time_match(m->time, m->rmc_next_time)) {
        m->time = left;
        return saved;
    }
    return rmc_public_time_enter(m);
}
/* One candidate instant strictly after `after`: tolerance-coincident
   candidates are one instant, reached at the latest of them
   (solve_events.rs canonical_dynamic_time_event). */
typedef struct { double time; bool defined; bool right; } RmcNextStop;
static void rmc_offer(RmcNextStop* next, double candidate, double after, bool right) {
    if (!isfinite(candidate) || candidate <= after || rmc_time_match(candidate, after)) return;
    if (next->defined && rmc_time_match(candidate, next->time)) {
        next->time = fmax(next->time, candidate);
        next->right |= right;
    } else if (!next->defined || candidate < next->time) {
        next->time = candidate; next->defined = true; next->right = right;
    }
}
/* The next time event strictly after `after`, stored as the instance's
   announced stop: static instants, the parameter of each direct time root,
   named deadlines, and the dynamic deadline rows at the settled
   coordinate. */
static {{ prefix }}Status rmc_next_time_event(ModelInstance* m, double after) {
    RmcNextStop next = { INFINITY, false, false };
    (void)after; (void)rmc_offer;
{%- if te.instants|length > 0 %}
    static const double instants[{{ te.instants|length }}] = { {% for t in te.instants %}{{ t }},{% endfor %} };
    for (size_t k = 0; k < {{ te.instants|length }}; ++k) rmc_offer(&next, instants[k], after, true);
{%- endif %}
{%- for index in te.announced + te.named_deadlines %}
    rmc_offer(&next, m->p[{{ index }}], after, true);
{%- endfor %}
{%- if te.deadlines > 0 %}
    {
    double deadlines[{{ te.deadlines }}];
    if (settle_values(m) != {{ prefix }}OK) return {{ prefix }}Error;
{%- for program in solve.events.dynamic_time_event_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "deadlines", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
    for (size_t k = 0; k < {{ te.deadlines }}; ++k) rmc_offer(&next, deadlines[k], after, true);
    }
{%- endif %}
    m->rmc_next_defined = next.defined;
    m->rmc_next_time = next.time;
    m->rmc_next_right = next.right;
    return {{ prefix }}OK;
}
{%- endmacro %}

{%- macro scalar_events(solve, fmi, prefix) %}
{%- set ev = fmi.scalar_events %}
{%- set nroots = ev.roots|length %}
{%- set nind = fmi.event_indicator_roots|length %}
{%- set ndisc = ev.discrete_targets|length %}
{%- set schedule = ev.schedule %}
/* Counts are constants rather than literals so a component without any
   indicator or root compiles warning-free; RMC_ROOT_SLOTS sizes arrays. */
static const size_t rmc_event_indicator_count = {{ nind }};
static const size_t rmc_root_count = {{ nroots }};
#define RMC_EVENT_INDICATORS rmc_event_indicator_count
#define RMC_ROOTS rmc_root_count
#define RMC_ROOT_SLOTS {{ [nroots, 1]|max }}
static const size_t rmc_indicator_root[{{ [nind, 1]|max }}] = { {% for root in fmi.event_indicator_roots %}{{ root }},{% else %}0{% endfor %} };
/* Zero domain per root: 1 positive, -1 non-positive, 0 previous side. */
static const signed char rmc_root_zero[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ 1 if root.zero == "positive" else (-1 if root.zero == "non_positive" else 0) }},{% else %}0{% endfor %} };
/* Relation-memory parameter per root, or -1. */
static const long rmc_root_memory[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ root.memory if root.memory is not none else -1 }},{% else %}-1{% endfor %} };
static const bool rmc_root_algebraic[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ "true" if root.algebraic_dependent else "false" }},{% else %}false{% endfor %} };
/* Roots that read only parameters, inputs, and statically fixed coordinates
   (RootSearchRole::Static): never searched, evaluated in Event Mode. */
static const bool rmc_root_static[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ "true" if root.role == "static" else "false" }},{% else %}false{% endfor %} };
{{ time_events(solve, ev.time_events, prefix) }}

/* All root rows at the current coordinate, as Event Mode reads them. */
static {{ prefix }}Status rmc_eval_roots(ModelInstance* m, double* roots) {
    (void)m; (void)roots;
{%- for program in solve.events.root_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "roots", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
    for (size_t k = 0; k < RMC_ROOTS; ++k) if (!isfinite(roots[k])) return {{ prefix }}Error;
    return {{ prefix }}OK;
}
/* solve_ops.rs orient_typed_root_zero and relation_memory_value_from_root. */
static double rmc_orient_root(double root, signed char zero) {
    if (root != 0.0) return root;
    return zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : root);
}
static double rmc_memory_value(double root) { return root < 0.0 ? 1.0 : 0.0; }
/* solve_ops.rs runtime_value_changed. */
static bool rmc_value_changed(double before, double after, double tol) {
    if (memcmp(&before, &after, sizeof(double)) == 0) return false;
    if (!isfinite(before) || !isfinite(after)) return true;
    double scale = fmax(1.0, fmax(fabs(before), fabs(after)));
    return fabs(before - after) > fabs(tol) * scale;
}
static bool rmc_root_overridden(const ModelInstance* m, size_t root) {
    for (size_t k = 0; k < m->rmc_override_count; ++k) if (m->rmc_override_root[k] == root) return true;
    return false;
}

/* component.rs event_indicators_into: the searched roots at the refreshed
   coordinate, an exact zero reported on its domain's side. */
static {{ prefix }}Status rmc_event_indicators(ModelInstance* m, double* z) {
    double roots[{{ [nroots, 1]|max }}];
    double saved = rmc_continuous_time_enter(m);
    {{ prefix }}Status status = settle_values(m);
    if (status == {{ prefix }}OK) status = rmc_eval_roots(m, roots);
    m->time = saved;
    if (status != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) {
        size_t root = rmc_indicator_root[k];
        double value = roots[root];
        if (value == 0.0) {
            signed char zero = rmc_root_zero[root];
            value = zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : (m->rmc_domain_valid && m->rmc_domain[k] ? DBL_EPSILON : -DBL_EPSILON));
        }
        z[k] = value;
    }
    return {{ prefix }}OK;
}

/* A static root's relation memory goes stale only when the host writes an
   input it reads in Continuous-Time Mode: no indicator can see that, so the
   completed step requests the event (an FMI step event) and its iteration
   moves the relation to its new side. */
static {{ prefix }}Status rmc_static_relations_stale(ModelInstance* m, bool* stale) {
    double roots[{{ [nroots, 1]|max }}];
    bool any = false;
    *stale = false;
    for (size_t root = 0; root < RMC_ROOTS; ++root) any |= rmc_root_static[root] && rmc_root_memory[root] >= 0;
    if (!any) return {{ prefix }}OK;
    double saved = rmc_continuous_time_enter(m);
    {{ prefix }}Status status = settle_values(m);
    if (status == {{ prefix }}OK) status = rmc_eval_roots(m, roots);
    m->time = saved;
    if (status != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t root = 0; root < RMC_ROOTS && !*stale; ++root) {
        long memory = rmc_root_memory[root];
        double value = rmc_orient_root(roots[root], rmc_root_zero[root]);
        *stale = rmc_root_static[root] && memory >= 0 && value != 0.0 && rmc_memory_value(value) != m->p[memory];
    }
    return {{ prefix }}OK;
}

/* component.rs complete_indicator_domains: a changed domain captures the
   event entry and arms each crossed root's post-event relation side. A
   completed step leaves the event instant, so reads stop taking its right
   limit (kernel.rs completed_integrator_step). */
static {{ prefix }}Status rmc_events_completed(ModelInstance* m, bool* enter) {
    double z[{{ [nind, 1]|max }}];
    bool stale = false;
    *enter = false;
    m->rmc_post_defined = false;
    if (rmc_static_relations_stale(m, &stale) != {{ prefix }}OK) return {{ prefix }}Error;
    *enter = stale;
    if (RMC_EVENT_INDICATORS == 0) return {{ prefix }}OK;
    if (rmc_event_indicators(m, z) != {{ prefix }}OK) return {{ prefix }}Error;
    if (!m->rmc_domain_valid) {
        for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) m->rmc_domain[k] = z[k] > 0.0;
        m->rmc_domain_valid = true;
        return {{ prefix }}OK;
    }
    bool changed = false;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) changed |= m->rmc_domain[k] != (z[k] > 0.0);
    if (!changed) return {{ prefix }}OK;
    memcpy(m->rmc_entry_y, m->y, sizeof(m->y));
    memcpy(m->rmc_entry_p, m->p, sizeof(m->p));
    m->rmc_entry_captured = true;
    m->rmc_override_count = 0;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) {
        bool now = z[k] > 0.0;
        if (now != m->rmc_domain[k]) {
            m->rmc_override_root[m->rmc_override_count] = rmc_indicator_root[k];
            m->rmc_override_value[m->rmc_override_count] = now ? 0.0 : 1.0;
            ++m->rmc_override_count;
        }
        m->rmc_domain[k] = now;
    }
    *enter = true;
    return {{ prefix }}OK;
}

/* relation_memory.rs apply_root_relation_memory_overrides. */
static bool rmc_apply_overrides(ModelInstance* m) {
    bool changed = false;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        long target = rmc_root_memory[m->rmc_override_root[k]];
        if (target < 0) continue;
        double value = m->rmc_override_value[k];
        changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return changed;
}

/* relation_memory.rs refresh_event_relation_memory and, with
   `algebraic_only`, update_algebraic_relation_memory_from_solver_y_except_overrides:
   release overrides the roots now contradict, then encode every other root. */
static {{ prefix }}Status rmc_relation_refresh(ModelInstance* m, bool algebraic_only, bool* changed) {
    double roots[{{ [nroots, 1]|max }}];
    *changed = false;
    if (rmc_eval_roots(m, roots) != {{ prefix }}OK) return {{ prefix }}Error;
    size_t kept = 0;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        size_t root = m->rmc_override_root[k];
        bool include = !algebraic_only || rmc_root_algebraic[root];
        if (!include || roots[root] == 0.0 || rmc_memory_value(roots[root]) == m->rmc_override_value[k]) {
            m->rmc_override_root[kept] = root;
            m->rmc_override_value[kept] = m->rmc_override_value[k];
            ++kept;
        } else {
            *changed = true;
        }
    }
    m->rmc_override_count = kept;
    for (size_t root = 0; root < RMC_ROOTS; ++root) {
        long target = rmc_root_memory[root];
        if (target < 0 || (algebraic_only && !rmc_root_algebraic[root]) || rmc_root_overridden(m, root)) continue;
        double value = rmc_memory_value(rmc_orient_root(roots[root], rmc_root_zero[root]));
        *changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return {{ prefix }}OK;
}

/* kernel.rs project_event_algebraics: refresh the algebraic coordinate and
   report a change beyond the instance tolerance. */
static {{ prefix }}Status rmc_event_projection(ModelInstance* m, bool* changed) {
    double before[Y_LEN];
    memcpy(before, m->y, sizeof(m->y));
    if (refresh_algebraics(m) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < Y_LEN; ++k) if (rmc_value_changed(before[k], m->y[k], m->tolerance)) { *changed = true; break; }
    return {{ prefix }}OK;
}


