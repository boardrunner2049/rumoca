/* guarded_assignments.rs apply_guarded_assignment_outputs: one guarded
   program's outputs reach the working state, an overridden relation memory
   keeping the located side. */
static void rmc_guarded_apply(ModelInstance* m, const size_t* index, const bool* in_y, double* values, size_t first, size_t count, bool* changed) {
    for (size_t g = first; g < first + count; ++g) {
        for (size_t k = 0; k < m->rmc_override_count; ++k) {
            long memory = rmc_root_memory[m->rmc_override_root[k]];
            if (memory >= 0 && !in_y[g] && (long)index[g] == memory) values[g] = m->rmc_override_value[k];
        }
        double* slot = in_y[g] ? &m->y[index[g]] : &m->p[index[g]];
        *changed |= memcmp(slot, &values[g], sizeof(double)) != 0;
        *slot = values[g];
    }
}
